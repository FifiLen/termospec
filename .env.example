# Nuxt Studio is opt-in in every environment.
NUXT_STUDIO_ENABLED=1

# Custom client login. Generate the hash with: npm run studio:password
NUXT_STUDIO_LOGIN_EMAIL=redaktor@example.com
NUXT_STUDIO_LOGIN_PASSWORD_HASH=<scrypt-v1-hash>
NUXT_STUDIO_LOGIN_DISPLAY_NAME=Redaktor Termospec

# Fine-grained GitHub PAT: only this repository, Contents = Read and write.
# Required by nuxt-studio 1.7.0 when custom authentication is used.
STUDIO_GITHUB_TOKEN=<github-fine-grained-personal-access-token>
